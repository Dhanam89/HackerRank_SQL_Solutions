SELECT ROUND(AVG(mid_values), 4) FROM (
    SELECT LAT_N AS mid_values
    FROM (
        SELECT LAT_N, 
               ROW_NUMBER() OVER (ORDER BY LAT_N) AS rn,
               COUNT(*) OVER () AS total_count
        FROM STATION
    ) AS ordered_values
    WHERE rn IN ((total_count + 1) / 2, (total_count + 2) / 2)
) AS median_values;
